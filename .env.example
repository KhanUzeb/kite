# Copy to .env (project root) and/or ~/.kite/.env, then fill in keys you use.
# Kite loads both via python-dotenv. Never commit real secrets.

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Hugging Face
HF_TOKEN=

# Google Gemini
GEMINI_API_KEY=

# Groq
GROQ_API_KEY=

# OpenCode Zen (pay-as-you-go) and OpenCode Go (subscription)
# Key from https://opencode.ai/auth  — Go can also use OPENCODE_GO_API_KEY
OPENCODE_API_KEY=
# OPENCODE_GO_API_KEY=

# NVIDIA NIM / NVIDIA API Catalog (build.nvidia.com)
# LiteLLM also reads NVIDIA_NIM_API_KEY if this is unset
NVIDIA_API_KEY=
# Self-hosted NIM: kite config --set-provider nvidia --set-api-base http://localhost:8000/v1

# Optional: override kite home (default ~/.kite)
# KITE_HOME=

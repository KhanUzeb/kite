# Copy to ~/.kite/.env (recommended) or a project-root .env, then fill in keys you use.
# Kite loads project .env first; ~/.kite/.env fills any key still unset or left empty (KEY=).
# Never commit real secrets. Leave unused keys commented out — empty KEY= can block login-saved keys
# until you remove the placeholder or put the real key in project .env.

# OpenAI
OPENAI_API_KEY=

# Anthropic (BYOK — API credits)
ANTHROPIC_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Hugging Face
HF_TOKEN=

# Google Gemini
GEMINI_API_KEY=

# Groq
GROQ_API_KEY=

# xAI (BYOK — API credits)
XAI_API_KEY=

# OpenCode Zen (pay-as-you-go) and OpenCode Go (subscription)
# Key from https://opencode.ai/auth  — Go can also use OPENCODE_GO_API_KEY
OPENCODE_API_KEY=
# OPENCODE_GO_API_KEY=

# NVIDIA NIM / NVIDIA API Catalog (build.nvidia.com)
# LiteLLM also reads NVIDIA_NIM_API_KEY if this is unset
NVIDIA_API_KEY=
# Self-hosted NIM: kite config --set-provider nvidia --set-api-base http://localhost:8000/v1

# Optional: override kite home (default ~/.kite)
# KITE_HOME=

# Maintainer only — unlocks `kite maintainer dashboard` (pick any secret; never commit)
# KITE_MAINTAINER_KEY=

# BYOK keys: `kite keys --set groq`, `/login groq`, or `kite setup` → ~/.kite/.env (owner-only).
# Model choice lives in ~/.kite/config.toml (`default_provider`, `default_model`), not in .env.

# --- BYOS subscriptions (plan OAuth — not API credits) ---
# Use `kite login` — credentials stay in each provider's official runtime, not in .env.
#
# ChatGPT / Codex:  kite login codex    (openai-codex SDK → ~/.codex)
# Claude Max/Pro:   kite login claude    (Claude Code CLI: claude auth login)
# Grok / xAI sub:   kite login grok      (grok CLI → ~/.grok)  or  kite login xai

# Optional — built-in Context7 docs tools (higher rate limits)
CONTEXT7_API_KEY=

# Copy to ~/.kite/.env (recommended) or project-root .env, then fill in keys you use.
# Kite loads project .env first; ~/.kite/.env fills unset or empty keys (KEY=).
# Never commit real secrets.

# OpenAI
OPENAI_API_KEY=

# Anthropic (BYOK — API credits)
ANTHROPIC_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Hugging Face
HF_TOKEN=

# Google Gemini
GEMINI_API_KEY=

# Groq
GROQ_API_KEY=

# xAI (BYOK — API credits)
XAI_API_KEY=

# OpenCode Zen (pay-as-you-go) and OpenCode Go (subscription)
# Key from https://opencode.ai/auth  — Go can also use OPENCODE_GO_API_KEY
OPENCODE_API_KEY=
# OPENCODE_GO_API_KEY=

# NVIDIA NIM / NVIDIA API Catalog (build.nvidia.com)
# LiteLLM also reads NVIDIA_NIM_API_KEY if this is unset
NVIDIA_API_KEY=
# Self-hosted NIM: kite config --set-provider nvidia --set-api-base http://localhost:8000/v1

# Optional: override kite home (default ~/.kite)
# KITE_HOME=

# Maintainer only — unlocks `kite maintainer dashboard` (pick any secret; never commit)
# KITE_MAINTAINER_KEY=

# BYOK keys: `kite keys --set groq`, `/login groq`, or `kite setup` → ~/.kite/.env (owner-only).
# Model choice lives in ~/.kite/config.toml (`default_provider`, `default_model`), not in .env.

# --- BYOS subscriptions (OAuth — not API credits) ---
# Tokens stored under ~/.kite/oauth/<provider>/ — use `kite login`, not env vars.
#
# ChatGPT / Codex:  kite login chatgpt   (or /login chatgpt)
# Claude Max/Pro:   kite login claude    (imports ~/.claude/.credentials.json when linked)
# Grok:             kite login grok

# Optional — built-in Context7 docs tools (higher rate limits)
CONTEXT7_API_KEY=

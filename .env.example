# ChatGPT / Codex subscription (BYOS — OAuth, not API credits)
# Run: kite login chatgpt   or   /login chatgpt in the REPL
# Tokens stored in ~/.kite/oauth/chatgpt/

# Claude Max/Pro subscription (BYOS)
# Run: kite login claude  (imports from ~/.claude/.credentials.json when Claude Code is linked)
# Tokens stored in ~/.kite/oauth/anthropic/

# Grok subscription (BYOS)
# Run: kite login grok
# Tokens stored in ~/.kite/oauth/xai/

# xAI API key (BYOK)
# XAI_API_KEY=...
